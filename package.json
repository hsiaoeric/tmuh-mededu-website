{
  "name": "tmuh-mededu-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "臺北醫學大學附設醫院 教學部官網 — React + Vite + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "doctor": "react-doctor",
    "typecheck": "tsc -b --noEmit",
    "content:generate": "vite-node scripts/generate-content.ts",
    "content:check": "vite-node scripts/generate-content.ts --check",
    "content:checkpoint": "vite-node scripts/checkpoint-content.ts",
    "predeploy": "npm run typecheck && VITE_BASE=/tmuh-mededu-website/ vite build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-tc": "5.3.0",
    "@fontsource/noto-serif-tc": "5.3.0",
    "@supabase/supabase-js": "2.78.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-scan/vite-plugin-react-scan": "^0.2.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "react-doctor": "0.9.12",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
