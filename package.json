{
  "name": "tmuh-mededu-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "臺北醫學大學附設醫院 教學部官網 — React + Vite + TypeScript",
  "homepage": "https://hsiaoeric.github.io/tmuh-mededu-website",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
